{#
/**
 * @file
 * Template for Blocco Spalla (Sidebar Block) content.
 * 
 * Uses elements variable to access field data.
 * Sidebar block layout for basic pages.
 */
#}

<div class="blocco-spalla bg-white border border-slate-200 rounded-lg p-6 shadow-sm">
  
  {# Admin Edit Button #}
  {% if logged_in and user.hasPermission('administer content') %}
    <div class="text-right mb-4">
      <a href="{{ url('entity.block_content.edit_form', {'block_content': elements['#block_content'].id()}) }}" class="inline-flex items-center gap-1 px-2 py-1 bg-indigo-500 text-white text-xs font-medium rounded hover:bg-indigo-600 transition-colors">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
        Edit
      </a>
    </div>
  {% endif %}

  {# Block Title #}
  {% if elements.field_titolo['#items'].0 %}
    <h2 class="text-xl font-bold text-slate-900 mb-4">
      {{ elements.field_titolo['#items'].0.value }}
    </h2>
  {% endif %}
  
  {# Block Image #}
  {% if elements.field_immagine['#items'].0 %}
    <div class="mb-4 max-h-[200px] overflow-hidden rounded-lg">
      <img src="{{ file_url(elements.field_immagine['#items'].entity.uri.value) }}" 
           alt="{{ elements.field_immagine['#items'].0.alt|default('') }}" 
           class="w-full h-auto object-cover" />
    </div>
  {% endif %}
  
  {# Block Body #}
  {% if elements.body['#items'].0 %}
    <div class="prose prose-sm max-w-none text-slate-700 leading-relaxed">
      {{ elements.body['#items'].0.value|raw }}
    </div>
  {% endif %}
  
  {# Link/Button #}
  {% if elements.field_first_link and elements.field_first_link['#items'].0 %}
    <div class="mt-4">
      <a href="{{ elements.field_first_link['#items'].0.uri }}" 
         class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors">
        {{ elements.field_first_link['#items'].0.title|default('Learn More') }}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  {% endif %}
  
</div>
