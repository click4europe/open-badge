{#
/**
 * @file
 * Template for Blocco Home block content.
 * 
 * Uses elements variable to access field data.
 * Sidebar card layout: logo/image at top, contact info below
 */
#}

<div class="blocco-home-sidebar bg-white border border-slate-200 rounded-lg p-6 shadow-sm">
  
  {# Admin Edit Button #}
  {% if logged_in and user.hasPermission('administer content') %}
    <div class="text-right mb-4">
      <a href="{{ url('entity.block_content.edit_form', {'block_content': elements['#block_content'].id()}) }}" class="inline-flex items-center gap-1 px-2 py-1 bg-indigo-500 text-white text-xs font-medium rounded hover:bg-indigo-600 transition-colors">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
        Edit
      </a>
    </div>
  {% endif %}

  {# Image/Logo at top #}
  {% if elements.field_immagine and elements.field_immagine['#items'].0 %}
    <div class="mb-4 text-center">
      <img src="{{ file_url(elements.field_immagine['#items'].entity.uri.value) }}" 
           alt="{{ elements.field_immagine['#items'].0.alt|default('') }}" 
           class="w-full max-w-[200px] mx-auto h-auto object-contain" />
    </div>
  {% elseif elements.field_image and elements.field_image['#items'].0 %}
    <div class="mb-4 text-center">
      <img src="{{ file_url(elements.field_image['#items'].entity.uri.value) }}" 
           alt="{{ elements.field_image['#items'].0.alt|default('') }}" 
           class="w-full max-w-[200px] mx-auto h-auto object-contain" />
    </div>
  {% endif %}
  
  {# Block Title #}
  {% if elements.field_titolo['#items'].0 %}
    <h3 class="text-lg font-bold text-slate-900 mb-3">
      {{ elements.field_titolo['#items'].0.value }}
    </h3>
  {% endif %}
  
  {# Subtitle #}
  {% if elements.field_sotto_titolo and elements.field_sotto_titolo['#items'].0 %}
    <p class="text-sm text-slate-600 font-medium mb-3">
      {{ elements.field_sotto_titolo['#items'].0.value }}
    </p>
  {% endif %}
  
  {# Block Body - Contact info/description #}
  {% if elements.body and elements.body['#items'].0 %}
    <div class="text-sm text-slate-700 leading-relaxed mb-3">
      {{ elements.body['#items'].0.value|raw }}
    </div>
  {% endif %}
  
  {# Second Description #}
  {% if elements.field_second_description and elements.field_second_description['#items'].0 %}
    <div class="text-sm text-slate-700 leading-relaxed mb-3">
      {{ elements.field_second_description['#items'].0.value|raw }}
    </div>
  {% endif %}
  
  {# Link/Button #}
  {% if elements.field_first_link and elements.field_first_link['#items'].0 %}
    <div class="mt-4">
      <a href="{{ elements.field_first_link['#items'].0.uri }}" 
         class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors w-full justify-center">
        {{ elements.field_first_link['#items'].0.title|default('Learn More') }}
      </a>
    </div>
  {% endif %}
  
</div>
