{#
/**
 * @file
 * Template for Basic Page content type.
 * 
 * Two-column layout: main content (70%) + sidebar blocks (30%)
 * Uses data.scheda array from Page::document()
 */
#}

{# Navbar - Render header block #}
{% if data.header_id %}
  {{ drupal_entity('block_content', data.header_id) }}
{% endif %}

{# Hero Section #}
{% if data.scheda.hero_title or data.scheda.hero_description %}
  {# Define styling variants based on compact mode #}
  {% set is_compact = data.scheda.hero_compact %}
  {% set hero_padding = is_compact ? 'py-8 lg:py-10' : 'py-12 lg:py-16' %}
  {% set hero_min_height = is_compact ? 'min-h-[240px]' : 'min-h-[320px]' %}
  {% set hero_gap = is_compact ? 'gap-8' : 'gap-12' %}
  {% set image_aspect = is_compact ? 'aspect-[16/9]' : 'aspect-[4/3]' %}
  {% set title_size = is_compact ? 'text-2xl sm:text-3xl lg:text-4xl' : 'text-3xl sm:text-4xl lg:text-5xl' %}
  {% set image_max_size = is_compact ? 'max-w-[300px] lg:max-w-[400px]' : 'max-w-full' %}

<section class="bg-[#050322]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 {{ hero_padding }} {{ hero_min_height }} flex items-center pt-32">
    <div class="grid {{ hero_gap }} lg:grid-cols-2 items-center w-full text-center lg:text-left">
      
      <!-- Text -->
      <div class="space-y-4 text-white">
        {% if data.scheda.hero_title %}
          <h1 class="{{ title_size }} font-extrabold leading-tight">
            {{ data.scheda.hero_title }}
          </h1>
        {% endif %}
        
        {% if data.scheda.hero_description %}
          <div class="font-body-large text-sm sm:text-base text-slate-200 max-w-xl">
            {{ data.scheda.hero_description }}
          </div>
        {% endif %}
      </div>

      <!-- Image -->
      {% if data.scheda.hero_image.path %}
        <div class="relative {{ image_max_size }} justify-self-center">
          <div class="rounded-3xl overflow-hidden shadow-2xl {{ image_aspect }}">
            <img src="{{ data.scheda.hero_image.path }}" 
                 alt="{{ data.scheda.hero_image.alt|default('Hero image') }}" 
                 class="w-full h-full object-cover" />
          </div>
        </div>
      {% endif %}
      
    </div>
  </div>
</section>
{% endif %}

{# Main Content Section with Sidebar #}
{% if data.scheda.sotto_titolo.0.value or data.scheda.image.path or data.scheda.body or data.scheda.notizie_sidebar %}
<section class="py-12 lg:py-16" style="background-color: #E9F5F6;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    {# Admin Action Buttons #}
    {% if data.admin_actions %}
      <div class="mb-6 flex flex-wrap gap-3">
        <a href="{{ data.admin_actions.view }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
          </svg>
          Visualizza
        </a>
        <a href="{{ data.admin_actions.edit }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Modifica
        </a>
        <a href="{{ data.admin_actions.delete }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors" onclick="return confirm('Sei sicuro di voler eliminare questa pagina?');">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Elimina
        </a>
        <a href="{{ data.admin_actions.revisions }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Revisioni
        </a>
      </div>
    {% endif %}
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      {# Left Column - Main Content (2/3 = 66%) #}
      <div class="main-content lg:col-span-2">
        
        {# Main Image at Top (if exists) #}
        {% if data.scheda.image.path %}
          <div class="mb-8 bg-slate-100 rounded-2xl overflow-hidden">
            <img src="{{ data.scheda.image.path }}" 
                 alt="{{ data.scheda.image.alt|default('') }}" 
                 class="w-full h-auto object-cover" />
          </div>
        {% endif %}
        
        {# Sotto Titolo (Title) - Below Image #}
        {% if data.scheda.sotto_titolo.0.value %}
          <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-6">
            {{ data.scheda.sotto_titolo.0.value }}
          </h2>
        {% endif %}
        
        {# Body Content - Below Title #}
        {% if data.scheda.body %}
          <div class="prose prose-sm max-w-none text-slate-700 leading-relaxed">
            {{ data.scheda.body | raw }}
          </div>
        {% endif %}
        
      </div>
      
      {# Right Column - Sidebar Blocks (1/3 = 33%) #}
      <aside class="sidebar-blocks space-y-6 lg:col-span-1" role="complementary">
        <!-- DEBUG: personalizzati exists? {{ data.scheda.personalizzati ? 'YES' : 'NO' }} -->
        {% if data.scheda.personalizzati %}
          <!-- DEBUG: personalizzati count: {{ data.scheda.personalizzati|length }} -->
          {% for key, value in data.scheda.personalizzati %}
            <!-- DEBUG: Block ID: {{ value.target_id }} -->
            <div class="sidebar-block">
              {{ drupal_entity('block_content', value.target_id) }}
            </div>
          {% endfor %}
        {% else %}
          <div class="p-4 bg-yellow-100 text-yellow-800 rounded">
            No sidebar blocks configured. Add blocks to the "Custom Blocks" field.
          </div>
        {% endif %}
      </aside>
      
    </div>
    
  </div>
</section>
{% endif %}


{# Footer - Render footer block #}
{% if data.footer_id %}
  {{ drupal_entity('block_content', data.footer_id) }}
{% endif %}
