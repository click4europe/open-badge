{#
/**
 * @file
 * Template for Basic Page content type.
 * 
 * Two-column layout: main content (70%) + sidebar blocks (30%)
 * Uses data.scheda array from Page::document()
 */
#}

{# Navbar - Render header block #}
{% if data.header_id %}
  {{ drupal_entity('block_content', data.header_id) }}
{% endif %}

{# Hero Section #}
{% if data.scheda.hero_title or data.scheda.hero_description %}
  {# Define styling variants based on compact mode #}
  {% set is_compact = data.scheda.hero_compact %}
  {% set hero_padding = is_compact ? 'py-8 lg:py-10' : 'py-12 lg:py-16' %}
  {% set hero_min_height = is_compact ? 'min-h-[240px]' : 'min-h-[320px]' %}
  {% set hero_gap = is_compact ? 'gap-8' : 'gap-12' %}
  {% set image_aspect = is_compact ? 'aspect-[16/9]' : 'aspect-[4/3]' %}
  {% set title_size = is_compact ? 'text-2xl sm:text-3xl lg:text-4xl' : 'text-3xl sm:text-4xl lg:text-5xl' %}
  {% set image_max_size = is_compact ? 'max-w-[300px] lg:max-w-[400px]' : 'max-w-full' %}

<section class="bg-[#050322]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 {{ hero_padding }} {{ hero_min_height }} flex items-center pt-32">
    <div class="grid {{ hero_gap }} lg:grid-cols-2 items-center w-full text-center lg:text-left">
      
      <!-- Text -->
      <div class="space-y-4 text-white">
        {% if data.scheda.hero_title %}
          <h1 class="{{ title_size }} font-extrabold leading-tight">
            {{ data.scheda.hero_title }}
          </h1>
        {% endif %}
        
        {% if data.scheda.hero_description %}
          <div class="font-body-large text-sm sm:text-base text-slate-200 max-w-xl">
            {{ data.scheda.hero_description|raw }}
          </div>
        {% endif %}
      </div>

      <!-- Image -->
      {% if data.scheda.hero_image.path %}
        <div class="relative {{ image_max_size }} justify-self-center">
          <div class="rounded-3xl overflow-hidden shadow-2xl {{ image_aspect }}">
            <img src="{{ data.scheda.hero_image.path }}" 
                 alt="{{ data.scheda.hero_image.alt|default('Hero image') }}" 
                 class="w-full h-full object-cover" />
          </div>
        </div>
      {% endif %}
      
    </div>
  </div>
</section>
{% endif %}

{# Main Content Section with Sidebar #}
{% if data.scheda.sotto_titolo.0.value or data.scheda.image.path or data.scheda.body or data.scheda.notizie_sidebar %}
<section class="py-12 lg:py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    {# Admin Action Buttons #}
    {% if data.admin_actions %}
      <div class="mb-6 flex flex-wrap gap-3">
        <a href="{{ data.admin_actions.view }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
          </svg>
          Visualizza
        </a>
        <a href="{{ data.admin_actions.edit }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Modifica
        </a>
        <a href="{{ data.admin_actions.delete }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors" onclick="return confirm('Sei sicuro di voler eliminare questa pagina?');">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Elimina
        </a>
        <a href="{{ data.admin_actions.revisions }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Revisioni
        </a>
      </div>
    {% endif %}
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      {# Left Column - Main Content (2/3 = 66%) #}
      <div class="main-content lg:col-span-2">
        
        {# Main Image at Top (if exists) #}
        {% if data.scheda.image.path %}
          <div class="mb-8 bg-slate-100 rounded-2xl overflow-hidden">
            <img src="{{ data.scheda.image.path }}" 
                 alt="{{ data.scheda.image.alt|default('') }}" 
                 class="w-full h-auto object-cover" />
          </div>
        {% endif %}
        
        {# Sotto Titolo (Title) - Below Image #}
        {% if data.scheda.sotto_titolo.0.value %}
          <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-6">
            {{ data.scheda.sotto_titolo.0.value }}
          </h2>
        {% endif %}
        
        {# Body Content - Below Title #}
        {% if data.scheda.body %}
          <div class="prose prose-sm max-w-none text-slate-700 leading-relaxed">
            {{ data.scheda.body | raw }}
          </div>
        {% endif %}
        
        {# FAQ Section - Accordion Style #}
        {% if data.scheda.faq and data.scheda.faq|length > 0 %}
          <div class="faq-section mt-12 space-y-4">
            <div class="space-y-3">
              {% for faq_item in data.scheda.faq %}
                <div class="faq-item border border-slate-200 rounded-lg overflow-hidden bg-white shadow-sm hover:shadow-md transition-shadow">
                  {# Question Header - Clickable #}
                  <button type="button" 
                          class="faq-question w-full flex items-center justify-between px-6 py-4 text-left bg-white hover:bg-slate-50 transition-colors"
                          aria-expanded="false"
                          aria-controls="faq-answer-{{ loop.index }}">
                    <span class="text-base lg:text-lg font-semibold text-slate-900 pr-4">
                      {{ faq_item.question }}
                    </span>
                    <svg class="faq-icon w-6 h-6 text-slate-600 flex-shrink-0 transition-transform duration-300 ease-in-out" 
                         fill="none" 
                         stroke="currentColor" 
                         viewBox="0 0 24 24"
                         stroke-width="2">
                      <path class="faq-icon-plus" stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                      <path class="faq-icon-x hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </button>
                  
                  {# Answer Content - Collapsible #}
                  <div id="faq-answer-{{ loop.index }}" 
                       class="faq-answer overflow-hidden transition-all duration-300 ease-in-out"
                       style="display: none;"
                       role="region"
                       aria-labelledby="faq-question-{{ loop.index }}">
                    <div class="px-6 py-4 prose prose-sm max-w-none text-slate-700 leading-relaxed border-t border-slate-200">
                      {{ faq_item.answer | raw }}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
        
      </div>
      
      {# Right Column - Sidebar (1/3 = 33%) #}
      <aside class="sidebar-blocks space-y-6 lg:col-span-1" role="complementary">
        
        {# Custom Blocks Section #}
        {% if data.scheda.personalizzati %}
          {% for key, value in data.scheda.personalizzati %}
            <div class="sidebar-block">
              {{ drupal_entity('block_content', value.target_id) }}
            </div>
          {% endfor %}
        {% endif %}

        {# Notizie Sidebar Section #}
        {% if data.notizie_sidebar and data.notizie_sidebar|length > 0 %}
          <div class="notizie-sidebar-section">
            <h3 class="text-xl font-bold text-slate-900 mb-4">Ultime Notizie</h3>
            {% for notizia in data.notizie_sidebar %}
              
              {# Separator line between cards (not before first) #}
              {% if not loop.first %}
                <hr class="my-6 border-slate-200">
              {% endif %}
              
              <article class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 mb-6">
                {# Notizia Image #}
                {% if notizia.image.path %}
                  <div class="aspect-[4/3] overflow-hidden bg-gray-100">
                    <img src="{{ notizia.image.path }}" 
                         alt="{{ notizia.image.alt }}" 
                         class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" 
                         loading="lazy" />
                  </div>
                {% else %}
                  <div class="aspect-[4/3] bg-gradient-to-br from-blue-100 to-blue-50 flex items-center justify-center">
                    <svg class="w-16 h-16 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                    </svg>
                  </div>
                {% endif %}
                
                {# Notizia Content #}
                <div class="p-6 space-y-3">
                  {# Date and Category #}
                  <div class="flex items-center gap-2 text-xs text-slate-500">
                    <span>{{ notizia.created }}</span>
                    <span>•</span>
                    <span>Notizie</span>
                  </div>
                  
                  {# Title #}
                  <h3 class="text-lg font-bold text-slate-900 line-clamp-2">
                    <a href="{{ path('entity.node.canonical', {'node': notizia.id}) }}" class="hover:text-blue-600 transition-colors">
                      {{ notizia.title }}
                    </a>
                  </h3>
                  
                  {# Teaser/Summary #}
                  {% if notizia.teaser %}
                    <p class="text-sm text-slate-600 line-clamp-3">
                      {{ notizia.teaser }}
                    </p>
                  {% endif %}
                  
                  {# Read More Link #}
                  <a href="{{ path('entity.node.canonical', {'node': notizia.id}) }}" 
                     class="inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors">
                    Leggi di più <span aria-hidden="true" class="ml-1">→</span>
                  </a>
                </div>
              </article>
            {% endfor %}
          </div>
        {% endif %}

        {# Show message if no sidebar content at all #}
        {% if not data.scheda.personalizzati and not data.notizie_sidebar %}
          <div class="p-4 bg-slate-100 text-slate-600 rounded">
            Nessun contenuto nella sidebar.
          </div>
        {% endif %}
      </aside>
      
    </div>
    
  </div>
</section>
{% endif %}


{# Footer - Render footer block #}
{% if data.footer_id %}
  {{ drupal_entity('block_content', data.footer_id) }}
{% endif %}
