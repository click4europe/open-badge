{# prezzi-e-abbonamenti-render.html.twig #}

{# Hero Section - Matching Home Page Style #}
{{ drupal_entity('block_content', 17) }}

{# Dynamic Pricing Cards Section #}
<section class="py-16 lg:py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    {% if data.pricing_section and data.pricing_section.link_edit %}
      <div class="text-right mb-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 text-slate-900 underline text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-lg">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          {{ data.pricing_section.link_edit }}
        </div>
      </div>
    {% endif %}
    
    {# Section Header #}
    <div class="text-center mb-12">
      {% if data.pricing_section and data.pricing_section.titolo and data.pricing_section.titolo|length > 0 %}
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-3">{{ data.pricing_section.titolo[0]['value'] }}</h2>
      {% endif %}
      
      {% if data.pricing_section and data.pricing_section.sub_title and data.pricing_section.sub_title|length > 0 %}
        <p class="text-base text-slate-600 mb-10">{{ data.pricing_section.sub_title[0]['value'] }}</p>
      {% endif %}
      
      {# Monthly/Yearly Toggle #}
      <div class="inline-flex items-center bg-white rounded-full p-1.5 shadow-sm border border-slate-200">
        <button id="monthly-toggle" class="pricing-toggle px-8 py-2.5 rounded-full text-sm font-semibold transition-all duration-200 bg-blue-600 text-white">
          Mensile
        </button>
        <button id="yearly-toggle" class="pricing-toggle px-8 py-2.5 rounded-full text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900">
          Annuale
        </button>
      </div>
    </div>

    {# Monthly Pricing Cards #}
    <div id="monthly-pricing" class="pricing-section">
      {% if pricing_monthly_cards is not empty %}
        {% if pricing_monthly_edit_url %}
          <div class="text-right mb-3">
            <a href="{{ pricing_monthly_edit_url }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Edit {{ pricing_monthly_title }}
            </a>
          </div>
        {% endif %}
        <div class="pricing-cards-grid">
          {% for card in pricing_monthly_cards %}
            {{ card }}
          {% endfor %}
        </div>
      {% else %}
        <div class="text-center py-8">
          <p class="text-slate-600">No monthly pricing plans available.</p>
        </div>
      {% endif %}
    </div>

    {# Annual Pricing Cards #}
    <div id="yearly-pricing" class="pricing-section hidden">
      {% if pricing_annual_cards is not empty %}
        {% if pricing_annual_edit_url %}
          <div class="text-right mb-3">
            <a href="{{ pricing_annual_edit_url }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Edit {{ pricing_annual_title }}
            </a>
          </div>
        {% endif %}
        <div class="pricing-cards-grid">
          {% for card in pricing_annual_cards %}
            {{ card }}
          {% endfor %}
        </div>
      {% else %}
        <div class="text-center py-8">
          <p class="text-slate-600">No annual pricing plans available.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>



<section class="py-16 bg-white" data-lazy-load>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">
  

    {# Section Header #}
    <div class="text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">
        Unisciti alle organizzazioni che utilizzano la certificazione digitale Open Badges.
      </h2>
    </div>

    {# Companies Grid Container #}
    <div class="relative">
      {# Logos (rendered by OrganizationsList.js) #}
      <div id="companies-pages" class="overflow-hidden transition-opacity"></div>

      {# Pagination (rendered by OrganizationsList.js) #}
      <div id="companies-pagination" class="companies-pagination"></div>

      {# Footer Text #}
      <p class="text-center text-sm text-slate-500 mt-6">
        Elenco (non esaustivo) degli Enti ed Organizzazioni presenti in piattaforma
      </p>

      {# CTA Button #}
      <div class="text-center mt-6">
        <a href="https://app.open-badge.eu/issuer-registration" class="inline-flex items-center gap-2 bg-[#0891b2] hover:bg-[#0e7490] text-white px-6 py-3 rounded-lg font-medium transition-colors">
          Registrati Ora
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>


    </div>
  </div>
</section>



