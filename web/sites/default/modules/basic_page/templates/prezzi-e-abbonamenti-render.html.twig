{# prezzi-e-abbonamenti-render.html.twig #}

{# Hero Section - Matching Home Page Style #}
{{ drupal_entity('block_content', 17) }}

{# Dynamic Pricing Cards Section #}
<section class="py-16 lg:py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    {% if data.pricing_section and data.pricing_section.link_edit %}
      <div class="text-right mb-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 text-slate-900 underline text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-lg">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          {{ data.pricing_section.link_edit }}
        </div>
      </div>
    {% endif %}
    
    {# Section Header #}
    <div class="text-center mb-12">
      {% if data.pricing_section and data.pricing_section.titolo and data.pricing_section.titolo|length > 0 %}
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-3">{{ data.pricing_section.titolo[0]['value'] }}</h2>
      {% endif %}
      
      {% if data.pricing_section and data.pricing_section.sub_title and data.pricing_section.sub_title|length > 0 %}
        <p class="text-base text-slate-600 mb-10">{{ data.pricing_section.sub_title[0]['value'] }}</p>
      {% endif %}
      
      {# Monthly/Yearly Toggle #}
      <div class="inline-flex items-center bg-white rounded-full p-1.5 shadow-sm border border-slate-200">
        <button id="monthly-toggle" class="pricing-toggle px-8 py-2.5 rounded-full text-sm font-semibold transition-all duration-200 bg-blue-600 text-white">
          Mensile
        </button>
        <button id="yearly-toggle" class="pricing-toggle px-8 py-2.5 rounded-full text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900">
          Annuale
        </button>
      </div>
    </div>

    {# Monthly Pricing Cards #}
    <div id="monthly-pricing" class="pricing-section">
      {% if pricing_monthly_cards is not empty %}
        {% if pricing_monthly_edit_url %}
          <div class="text-right mb-3">
            <a href="{{ pricing_monthly_edit_url }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Edit {{ pricing_monthly_title }}
            </a>
          </div>
        {% endif %}
        <div class="pricing-cards-grid">
          {% for card in pricing_monthly_cards %}
            {{ card }}
          {% endfor %}
        </div>
      {% else %}
        <div class="text-center py-8">
          <p class="text-slate-600">No monthly pricing plans available.</p>
        </div>
      {% endif %}
    </div>

    {# Annual Pricing Cards #}
    <div id="yearly-pricing" class="pricing-section hidden">
      {% if pricing_annual_cards is not empty %}
        {% if pricing_annual_edit_url %}
          <div class="text-right mb-3">
            <a href="{{ pricing_annual_edit_url }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Edit {{ pricing_annual_title }}
            </a>
          </div>
        {% endif %}
        <div class="pricing-cards-grid">
          {% for card in pricing_annual_cards %}
            {{ card }}
          {% endfor %}
        </div>
      {% else %}
        <div class="text-center py-8">
          <p class="text-slate-600">No annual pricing plans available.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>


{# Companies Section - Grid with Pagination #}
{% if company_logos and company_logos.pages %}
<section class="py-16 bg-white" data-lazy-load>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">
    {# Edit Button #}
    {% if company_logos.edit_url %}
      <div class="text-right mb-4">
        <a href="{{ company_logos.edit_url }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit Company Logos
        </a>
      </div>
    {% endif %}

    {# Section Header #}
    <div class="text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">
        {{ company_logos.section_title }}
      </h2>
    </div>

    {# Companies Grid Container #}
    <div class="relative">
      {# Pages Container #}
      <div id="companies-pages" class="overflow-hidden">
        {% for page_index, page_logos in company_logos.pages %}
          <div class="companies-page{% if page_index > 0 %} hidden{% endif %}" data-page="{{ page_index + 1 }}">
            <div class="image-logo-showcase">
              {% for logo in page_logos %}
                {% set link_url = logo.company_url ?: logo.badge_url %}
                {% if link_url %}
                  <a target="_blank" title="{{ logo.name }}" href="{{ logo.badge_url }}">
                    <img class="logo-customer" src="{{ logo.logo_url }}" alt="{{ logo.name }}" loading="lazy" decoding="async" />
                  </a>
                
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>

      {# Pagination #}
      {% if company_logos.total_pages > 1 %}
        <div class="flex items-center justify-center gap-3 mt-10">
          <button type="button" id="companies-prev" class="group relative px-4 py-2 rounded-full bg-white border-2 border-slate-200 text-slate-600 font-medium transition-all duration-300 hover:border-[#0891b2] hover:text-[#0891b2] hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed" aria-label="Previous page">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.75 19.5L8.25 12l7.5-7.5"></path>
              </svg>
              <span class="hidden sm:inline">Precedente</span>
            </span>
          </button>
          
          <div class="flex items-center gap-2">
            <div class="hidden sm:flex items-center gap-1 px-3 py-1">
              <span class="text-sm text-slate-500">Pagina</span>
              <span id="current-page-indicator" class="text-sm font-semibold text-[#0891b2]">1</span>
              <span class="text-sm text-slate-500">di</span>
              <span class="text-sm font-semibold text-slate-700">{{ company_logos.total_pages }}</span>
            </div>
            
            <div id="companies-pagination" class="flex items-center gap-1.5">
              {% for i in 1..company_logos.total_pages %}
                <button type="button" class="relative px-4 py-2 rounded-full page-btn flex-shrink-0 relative w-10 h-10 min-w-[2.5rem] min-h-[2.5rem] rounded-xl font-semibold text-sm transform transition-all duration-300 hover:scale-110 hover:shadow-xl{% if i == 1 %} bg-[#0891b2] text-white shadow-md{% else %} bg-white border-2 border-slate-200 text-slate-600 hover:border-[#0891b2] hover:text-[#0891b2] hover:shadow-md{% endif %}" data-page="{{ i }}">
                  <span class="relative z-10">{{ i }}</span>
                </button>
              {% endfor %}
            </div>
          </div>
          
          <button type="button" id="companies-next" class="group relative px-4 py-2 rounded-full bg-white border-2 border-slate-200 text-slate-600 font-medium transition-all duration-300 hover:border-[#0891b2] hover:text-[#0891b2] hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed" aria-label="Next page">
            <span class="flex items-center gap-2">
              <span class="hidden sm:inline">Successiva</span>
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.25 4.5L15.75 12l-7.5 7.5"></path>
              </svg>
            </span>
          </button>
        </div>
      {% endif %}

      {# Footer Text #}
      <p class="text-center text-sm text-slate-500 mt-6">
        Elenco (non esaustivo) degli Enti ed Organizzazioni presenti in piattaforma
      </p>

      {# CTA Button #}
      <div class="text-center mt-6">
        <a href="/" class="inline-flex items-center gap-2 bg-[#0891b2] hover:bg-[#0e7490] text-white px-6 py-3 rounded-lg font-medium transition-colors">
          Registrati Ora
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
{% endif %}


