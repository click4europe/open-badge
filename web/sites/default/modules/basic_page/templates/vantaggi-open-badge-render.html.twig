{# vantaggi-open-badge-render.html.twig #}

{# Hero Section using reusable component #}
{% set hero_block = drupal_entity('block_content', 37) %}
{{ hero_block|render }}

{# Benefits Grid Section - Dynamic from benefits_section block #}
<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    {% if data.benefits_section and data.benefits_section.link_edit %}
      <div class="text-right mb-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 text-slate-900 underline text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-lg">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          {{ data.benefits_section.link_edit }}
        </div>
      </div>
    {% endif %}

    <div class="text-center mb-12">
      {% if data.benefits_section and data.benefits_section.section_title %}
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 mb-4">
          {{ data.benefits_section.section_title }}
        </h2>
      {% endif %}

      {% if data.benefits_section and data.benefits_section.sub_title %}
        <p class="text-lg text-blue-600 font-semibold mb-4">
          {{ data.benefits_section.sub_title }}
        </p>
      {% endif %}

      {% if data.benefits_section and data.benefits_section.second_title %}
        <h3 class="text-xl sm:text-2xl font-semibold text-slate-800 mb-4">
          {{ data.benefits_section.second_title }}
        </h3>
      {% endif %}
    </div>

    {# Dynamic Benefits Grid #}
    {% if data.benefits_section and data.benefits_section.benefit_items %}
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {% for benefit in data.benefits_section.benefit_items %}
          <div class="bg-slate-100 rounded-xl p-6 hover:shadow-md transition-shadow duration-300">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 mt-1">
                <svg class="w-6 h-6 text-slate-700" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
              <span class="text-sm text-slate-700 leading-relaxed">{{ benefit.description|striptags }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{# Information Section - Dynamic from info_section block #}
<section class="py-16 lg:py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    {% if data.info_section and data.info_section.link_edit %}
      <div class="text-right mb-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 text-slate-900 underline text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-lg">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          {{ data.info_section.link_edit }}
        </div>
      </div>
    {% endif %}

    <div class="grid lg:grid-cols-2 gap-12 items-center">
      {# Text Content #}
      <div class="space-y-6">
        {% if data.info_section and data.info_section.titolo and data.info_section.titolo|length > 0 %}
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
            {{ data.info_section.titolo[0]['value'] }}
          </h2>
        {% endif %}

        {% if data.info_section and data.info_section.sub_title and data.info_section.sub_title|length > 0 %}
          <p class="text-lg text-blue-600 font-semibold">{{ data.info_section.sub_title[0]['value'] }}</p>
        {% endif %}

        <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-4">
          {% if data.info_section and data.info_section.body and data.info_section.body|length > 0 %}
            <div class="prose prose-base max-w-none">
              {{ data.info_section.body[0]['value']|raw }}
            </div>
          {% endif %}

          {% if data.info_section and data.info_section.second_description and data.info_section.second_description|length > 0 %}
            <div class="prose prose-base max-w-none">
              {{ data.info_section.second_description[0]['value']|raw }}
            </div>
          {% endif %}
        </div>
      </div>

      {# Image #}
      <div class="relative">
        <div class="rounded-xl overflow-hidden shadow-lg">
          {% if data.info_section and data.info_section.immagine_url %}
            <img src="{{ data.info_section.immagine_url }}" 
                 alt="{{ data.info_section.immagine_alt|default('Informazioni sugli Open Badge') }}" 
                 class="w-full h-auto object-cover">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
