  casi_studio: data.casi_studio,
  casi_studio_edit: data.casi_studio_edit,
  blocco_home: data.blocco_home,
  blocco_home_obv: data.blocco_home_obv,
  blocco_home_funziona: data.blocco_home_funziona,
  blocco_inizia_ora: data.blocco_inizia_ora
} %}
