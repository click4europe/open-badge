{# privacy-render.html.twig #}

{# Hero Section #}
{% set hero_block = drupal_entity('block_content', 54) %}
{{ hero_block|render }}

{# Privacy Content Section #}
<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {% if data.privacy_block %}
      {# Admin Edit Button #}
      {% if data.privacy_block.link_edit %}
        <div class="text-right mb-6">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 text-white text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-lg">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            {{ data.privacy_block.link_edit }}
          </div>
        </div>
      {% endif %}

      {# Image #}
      {% if data.privacy_block.immagine_url %}
        <div class="mb-8 rounded-2xl overflow-hidden shadow-lg">
          <img 
            src="{{ data.privacy_block.immagine_url }}" 
            alt="{{ data.privacy_block.immagine_alt|default('Privacy') }}" 
            class="w-full h-auto object-cover"
          />
        </div>
      {% endif %}

      {# Title #}
      {% if data.privacy_block.titolo and data.privacy_block.titolo|length > 0 %}
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-6">
          {{ data.privacy_block.titolo[0]['value'] }}
        </h1>
      {% endif %}

      {# Body Content #}
      {% if data.privacy_block.body and data.privacy_block.body|length > 0 %}
        <div class="prose prose-slate prose-lg max-w-none">
          <div class="text-slate-700 leading-relaxed">
            {{ data.privacy_block.body[0]['value']|raw }}
          </div>
        </div>
      {% endif %}

    {% endif %}
  </div>
</section>
