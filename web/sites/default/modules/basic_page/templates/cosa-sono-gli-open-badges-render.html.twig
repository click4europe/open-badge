        {% else %}
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">Come funziona</h2>
        {% endif %}

        {% if data.blocco_home_funziona and data.blocco_home_funziona.sub_title and data.blocco_home_funziona.sub_title|length > 0 %}
          <p class="text-lg text-blue-600 font-semibold">{{ data.blocco_home_funziona.sub_title[0]['value'] }}</p>
        {% endif %}

        {% if data.blocco_home_funziona and data.blocco_home_funziona.body and data.blocco_home_funziona.body|length > 0 %}
          <div class="prose prose-base max-w-none text-slate-700 leading-relaxed">
            {{ data.blocco_home_funziona.body[0]['value']|raw }}
          </div>
        {% else %}
          <div class="space-y-4">
            <div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Creazione:</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                L'ente o l'organizzazione crea un badge digitale inserendo i metadati rilevanti (competenze, corso, ente, data).
              </p>
            </div>

            <div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Assegnazione:</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Il badge viene assegnato agli utenti che hanno completato un corso, una formazione o un evento.
              </p>
            </div>

            <div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Condivisione:</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Gli utenti possono salvare i badge in un portafoglio digitale e condividerli su social network o piattaforme professionali come LinkedIn.
              </p>
            </div>

            <div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Verifica:</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Chiunque può cliccare sul badge per verificarne la validità, visualizzare le informazioni e accertarsi dell'autenticità, grazie al collegamento con lo standard 1EDTECH.
              </p>
            </div>
          </div>
        {% endif %}

        {% if data.blocco_home_funziona and data.blocco_home_funziona.second_description and data.blocco_home_funziona.second_description|length > 0 %}
          <div class="prose prose-base max-w-none text-slate-700 leading-relaxed">
            {{ data.blocco_home_funziona.second_description[0]['value']|raw }}
          </div>
        {% endif %}

        <div class="pt-4">
