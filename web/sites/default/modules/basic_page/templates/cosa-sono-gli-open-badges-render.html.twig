          {{ data.blocco_home_funziona.link_edit }}
        </div>
      </div>
    {% endif %}

    <div class="grid gap-12 lg:grid-cols-2 items-center">
      {# Left: Image #}
      <div>
        <div class="relative">
          {% if data.blocco_home_funziona and data.blocco_home_funziona.immagine_url %}
