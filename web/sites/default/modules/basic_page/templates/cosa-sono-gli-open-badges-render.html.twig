{# cosa-sono-gli-open-badges-render.html.twig #}
{% set hero_block = drupal_entity('block_content', 21) %}
{{ hero_block|render }}

{# La tecnologia Open Badge Section - Dynamic from blocco_tecnologia or static fallback #}
<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    {% if data.blocco_tecnologia and data.blocco_tecnologia.link_edit %}
      <div class="text-right mb-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 text-slate-900 underline text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-lg">
          {{ data.blocco_tecnologia.link_edit }}
        </div>
      </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      {# Left Column - Image #}
      <div class="order-2 lg:order-1">
        <div class="relative rounded-2xl overflow-hidden shadow-lg">
          {% if data.blocco_tecnologia and data.blocco_tecnologia.immagine_url %}
            <img src="{{ data.blocco_tecnologia.immagine_url }}" 
                 alt="{{ data.blocco_tecnologia.immagine_alt|default('La tecnologia Open Badge') }}" 
                 class="w-full h-auto object-cover">
        
          {% endif %}
        </div>
      </div>

      {# Right Column - Content #}
      <div class="order-1 lg:order-2">
        {% if data.blocco_tecnologia and data.blocco_tecnologia.titolo and data.blocco_tecnologia.titolo|length > 0 %}
          <h2 class="font-heading text-3xl lg:text-4xl text-slate-900 mb-6">{{ data.blocco_tecnologia.titolo[0]['value'] }}</h2>
        {% endif %}

        {% if data.blocco_tecnologia and data.blocco_tecnologia.sub_title and data.blocco_tecnologia.sub_title|length > 0 %}
          <p class="text-lg text-blue-600 font-semibold mb-4">{{ data.blocco_tecnologia.sub_title[0]['value'] }}</p>
        {% endif %}
        
        <div class="font-body text-slate-700 space-y-4">
          {% if data.blocco_tecnologia and data.blocco_tecnologia.body and data.blocco_tecnologia.body|length > 0 %}
            <div class="prose prose-base max-w-none">
              {{ data.blocco_tecnologia.body[0]['value']|raw }}
            </div>
          {% endif %}

          {% if data.blocco_tecnologia and data.blocco_tecnologia.second_description and data.blocco_tecnologia.second_description|length > 0 %}
            <div class="prose prose-base max-w-none">
              {{ data.blocco_tecnologia.second_description[0]['value']|raw }}
            </div>
          {% endif %}

          <div class="pt-4">
            <a href="#contatti" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-slate-900 bg-white text-slate-900 text-sm font-semibold hover:bg-slate-900 hover:text-white transition-colors">
              Inizia Ora
              <span aria-hidden="true" class="ml-2">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

