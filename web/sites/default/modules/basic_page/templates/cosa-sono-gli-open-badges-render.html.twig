{# La piattaforma open-badge.eu per gli studenti ed i formatori - Interactive FAQ Section #}
<section class="py-16 lg:py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {% if data.faq_section and data.faq_section.link_edit %}
      <div class="text-right mb-6">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 text-slate-900 underline text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-lg">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          {{ data.faq_section.link_edit }}
        </div>
      </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 xl:gap-24">
      
      {# Left Column - FAQ Items #}
      <div class="space-y-8">
        {% if data.faq_section and data.faq_section.section_title %}
          <h2 class="font-title-large text-3xl lg:text-4xl xl:text-5xl text-slate-900 mb-8 lg:mb-12 leading-tight">
            {{ data.faq_section.section_title }}
          </h2>
     
        {% endif %}
        
        <div class="space-y-2">
          {% if data.faq_section and data.faq_section.faq_items %}
            {% for faq in data.faq_section.faq_items %}
              <div class="faq-item cursor-pointer py-6 lg:py-7 border-b border-slate-300 transition-all duration-200 hover:bg-blue-50/50 rounded-lg px-4" 
                   data-faq-index="{{ faq.index }}" 
                   data-faq-image="{{ faq.image_url }}"
                   data-faq-alt="{{ faq.image_alt }}">
                <div class="flex items-center gap-6">
                  <span class="font-title-small text-2xl text-slate-400 flex-shrink-0 w-8 text-center">{{ faq.index }}</span>
                  <div class="flex-1 min-w-0">
                    <h3 class="font-title text-lg lg:text-xl text-slate-900 hover:text-[#5299D8] transition-colors mb-3 font-semibold">
                      {{ faq.title }}
                    </h3>
                    <div class="faq-content hidden font-body text-base text-slate-600 leading-relaxed space-y-3 pt-1">
                      {{ faq.description|raw }}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}

          {% endif %}
        </div>
      </div>

      {# Right Column - Dynamic Image #}
      <div class="order-1 lg:order-2">
        <div class="rounded-2xl overflow-hidden shadow-xl bg-white sticky top-8 max-w-md mx-auto lg:mx-0 transition-transform duration-300 hover:scale-[1.01]">
          {% if data.faq_section and data.faq_section.faq_items and data.faq_section.faq_items|length > 0 %}
            <img id="faq-image" 
                 src="{{ data.faq_section.faq_items[0].image_url }}" 
                 alt="{{ data.faq_section.faq_items[0].image_alt }}" 
                 class="w-full h-auto object-cover transition-opacity duration-300">
            {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{# Inizia Ora Section - Dynamic from blocco_inizia_ora or static fallback #}
