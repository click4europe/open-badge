            Inizia ora
            <span aria-hidden="true" class="ml-2">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{# La piattaforma open-badge.eu per gli studenti ed i formatori - Interactive FAQ Section #}
<section class="py-16 lg:py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">
      
      {# Left Column - FAQ Items #}
      <div class="space-y-6">
        <h2 class="font-title-large text-3xl lg:text-4xl text-slate-900 mb-12">
          La piattaforma open-badge.eu per gli studenti ed i formatori
        </h2>
        
        <div class="space-y-0">
          {# FAQ Item 1 - My Badges #}
          <div class="faq-item cursor-pointer py-10 border-b border-slate-300 transition-colors" data-faq="mybadges" onmouseover="this.style.backgroundColor='#E3F2FD'" onmouseout="this.style.backgroundColor=''">
            <div class="flex items-start gap-4">
              <span class="font-title-small text-slate-400 mt-1">1</span>
              <div class="flex-1">
                <h3 class="font-title text-slate-900 hover:text-[#5299D8] transition-colors mb-3">My Badges</h3>
                <div class="faq-content hidden font-body-small text-slate-600 leading-relaxed pr-4">
                  In questa sezione l'utente finale può visualizzare, gestire e condividere tutti i tuoi badge digitali. Ogni certificato è verificabile e pronto per essere pubblicato sui propri canali social o condiviso con datori di lavoro, offrendo una panoramica chiara delle competenze e dei traguardi formativi.
                </div>
              </div>
            </div>
          </div>

          {# FAQ Item 2 - Percorsi di apprendimento #}
          <div class="faq-item cursor-pointer py-10 border-b border-slate-300 transition-colors" data-faq="learning" onmouseover="this.style.backgroundColor='#E3F2FD'" onmouseout="this.style.backgroundColor=''">
            <div class="flex items-start gap-4">
              <span class="font-title-small text-slate-400 mt-1">2</span>
              <div class="flex-1">
                <h3 class="font-title text-slate-900 hover:text-[#5299D8] transition-colors mb-3">Percorsi di apprendimento</h3>
                <div class="faq-content hidden font-body-small text-slate-600 leading-relaxed pr-4">
                  Monitora i tuoi progressi attraverso percorsi formativi strutturati. Visualizza i badge ottenuti in ogni fase del percorso e traccia il tuo sviluppo professionale nel tempo.
                </div>
              </div>
            </div>
          </div>

          {# FAQ Item 3 - Earners Lists #}
          <div class="faq-item cursor-pointer py-10 border-b border-slate-300 transition-colors" data-faq="earners" onmouseover="this.style.backgroundColor='#E3F2FD'" onmouseout="this.style.backgroundColor=''">
            <div class="flex items-start gap-4">
              <span class="font-title-small text-slate-400 mt-1">3</span>
              <div class="flex-1">
                <h3 class="font-title text-slate-900 hover:text-[#5299D8] transition-colors mb-3">Earners Lists</h3>
                <div class="faq-content hidden font-body-small text-slate-600 leading-relaxed pr-4">
                  Accedi alle liste di badge earners per vedere chi ha ottenuto specifici badge. Connettiti con altri professionisti che hanno competenze simili e costruisci la tua rete professionale.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {# Right Column - Dynamic Image #}
      <div class="order-1 lg:order-2">
        <div class="rounded-lg overflow-hidden shadow-xl bg-white sticky top-8 max-w-md mx-auto">
          <img id="faq-image" src="/themes/custom/tailwind/images/public/IMG_openbadge/faq-1.png" alt="Dashboard" class="w-full h-auto object-cover">
        </div>
      </div>
    </div>
  </div>
</section>

