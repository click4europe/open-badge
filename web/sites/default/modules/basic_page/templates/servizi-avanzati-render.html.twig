{# servizi-avanzati-render.html.twig #}

{# Hero Section using reusable component #}
{# Replace old hero include with #}
{% set hero_block = drupal_entity('block_content', 22) %}
{{ hero_block|render }}

{# Main Content Section - Dynamic from blocco_servizi_avanzati or static fallback #}
<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    {% if data.blocco_servizi_avanzati and data.blocco_servizi_avanzati.link_edit %}
      <div class="text-right mb-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 text-slate-900 underline text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-lg">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          {{ data.blocco_servizi_avanzati.link_edit }}
        </div>
      </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      
      {# Left Column - Image #}
      <div class="order-2 lg:order-1">
        <div class="rounded-2xl overflow-hidden shadow-lg bg-slate-100">
          {% if data.blocco_servizi_avanzati and data.blocco_servizi_avanzati.immagine_url %}
            <img src="{{ data.blocco_servizi_avanzati.immagine_url }}" 
                 alt="{{ data.blocco_servizi_avanzati.immagine_alt|default('Servizi avanzati') }}" 
                 class="w-full h-auto object-cover">
          {% else %}
            <img src="/themes/custom/tailwind/images/public/img_2.png" alt="Servizi avanzati" class="w-full h-auto object-cover">
          {% endif %}
        </div>
        
        {% if data.blocco_servizi_avanzati and data.blocco_servizi_avanzati.second_description and data.blocco_servizi_avanzati.second_description|length > 0 %}
          <div class="prose prose-lg text-slate-700 mt-6">
            {{ data.blocco_servizi_avanzati.second_description[0]['value']|raw }}
          </div>
        {% endif %}
      </div>

      {# Right Column - Content #}
      <div class="order-1 lg:order-2">
        {% if data.blocco_servizi_avanzati and data.blocco_servizi_avanzati.titolo and data.blocco_servizi_avanzati.titolo|length > 0 %}
          <h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-6">{{ data.blocco_servizi_avanzati.titolo[0]['value'] }}</h2>
        {% endif %}

        {% if data.blocco_servizi_avanzati and data.blocco_servizi_avanzati.sub_title and data.blocco_servizi_avanzati.sub_title|length > 0 %}
          <p class="text-lg text-blue-600 font-semibold mb-6">{{ data.blocco_servizi_avanzati.sub_title[0]['value'] }}</p>
        {% endif %}
        
        {% if data.blocco_servizi_avanzati and data.blocco_servizi_avanzati.body and data.blocco_servizi_avanzati.body|length > 0 %}
          <div class="prose prose-lg text-slate-700">
            {{ data.blocco_servizi_avanzati.body[0]['value']|raw }}
          </div>
        {% endif %}

        {% if data.blocco_servizi_avanzati and data.blocco_servizi_avanzati.first_link and data.blocco_servizi_avanzati.first_link|length > 0 %}
          <div class="mt-6">
            <a href="{{ data.blocco_servizi_avanzati.first_link[0]['uri'] }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-slate-900 bg-slate-900 text-white text-sm font-semibold hover:bg-white hover:text-slate-900 transition-colors">
              {{ data.blocco_servizi_avanzati.first_link[0]['title']|default('Scopri di più') }}
              <span aria-hidden="true" class="ml-2">→</span>
            </a>
          </div>
        {% endif %}

        {% if data.blocco_servizi_avanzati and data.blocco_servizi_avanzati.second_link and data.blocco_servizi_avanzati.second_link|length > 0 %}
          <div class="mt-4">
            <a href="{{ data.blocco_servizi_avanzati.second_link[0]['uri'] }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-slate-900 bg-white text-slate-900 text-sm font-semibold hover:bg-slate-900 hover:text-white transition-colors">
              {{ data.blocco_servizi_avanzati.second_link[0]['title']|default('Altro') }}
              <span aria-hidden="true" class="ml-2">→</span>
            </a>
          </div>
        {% endif %}

       
      </div>
    </div>
  </div>
</section>

{# Inizia Ora Section - Dynamic from blocco_inizia_ora #}
<section class="py-20 lg:py-28 bg-[#050322]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    
    {% if data.blocco_inizia_ora and data.blocco_inizia_ora.link_edit %}
      <div class="text-right mb-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 text-slate-900 underline text-sm font-medium rounded-lg hover:bg-indigo-600 transition-colors shadow-lg">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          {{ data.blocco_inizia_ora.link_edit }}
        </div>
      </div>
    {% endif %}

    <div class="space-y-6">
      {% if data.blocco_inizia_ora and data.blocco_inizia_ora.titolo and data.blocco_inizia_ora.titolo|length > 0 %}
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">
          {{ data.blocco_inizia_ora.titolo[0]['value'] }}
        </h2>
      {% endif %}

      {% if data.blocco_inizia_ora and data.blocco_inizia_ora.sub_title and data.blocco_inizia_ora.sub_title|length > 0 %}
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto">
          {{ data.blocco_inizia_ora.sub_title[0]['value'] }}
        </p>
      {% endif %}

      {% if data.blocco_inizia_ora and data.blocco_inizia_ora.body and data.blocco_inizia_ora.body|length > 0 %}
        <div class="prose prose-lg prose-invert max-w-2xl mx-auto">
          {{ data.blocco_inizia_ora.body[0]['value']|raw }}
        </div>
      {% endif %}

      {% if data.blocco_inizia_ora and data.blocco_inizia_ora.second_description and data.blocco_inizia_ora.second_description|length > 0 %}
        <div class="prose prose-lg prose-invert max-w-2xl mx-auto">
          {{ data.blocco_inizia_ora.second_description[0]['value']|raw }}
        </div>
      {% endif %}

      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a href="/prezzi-e-abbonamenti" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white text-white text-sm font-semibold hover:bg-white hover:text-[#050322] transition-colors">
          Abbonamenti
          <span aria-hidden="true" class="ml-2">→</span>
        </a>
        <a href="/contatti" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/50 text-white/80 text-sm font-semibold hover:bg-white/10 transition-colors">
          Contattaci
          <span aria-hidden="true" class="ml-2">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
